{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "maxLength": 70,
      "pattern": "^(?![\\s\\S]*<[A-Za-z!/?])"
    },
    "fecha": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "etiqueta": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^(?![\\s\\S]*<[A-Za-z!/?])"
    },
    "especie": {
      "type": "string",
      "maxLength": 70,
      "pattern": "^(?![\\s\\S]*<[A-Za-z!/?])"
    },
    "resumen": {
      "type": "string",
      "maxLength": 170,
      "pattern": "^(?![\\s\\S]*<[A-Za-z!/?])"
    },
    "arte": {
      "type": "string",
      "enum": [
        "medusas",
        "banco",
        "arrecife",
        "arena"
      ]
    }
  },
  "required": [
    "titulo",
    "fecha",
    "etiqueta",
    "resumen",
    "arte"
  ]
}
