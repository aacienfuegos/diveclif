{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string",
      "maxLength": 30,
      "pattern": "^(?![\\s\\S]*<[A-Za-z!/?])"
    },
    "orden": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "linea": {
      "type": "string",
      "enum": [
        "recreativa",
        "profesional"
      ]
    },
    "profundidadMax": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "agencias": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 20,
        "pattern": "^(?![\\s\\S]*<[A-Za-z!/?])"
      }
    },
    "resumen": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(?![\\s\\S]*<[A-Za-z!/?])"
    },
    "convocatorias": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "inicio": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "fin": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "lugar": {
            "type": "string",
            "enum": [
              "madrid",
              "cabo-de-palos"
            ]
          },
          "plazas": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "libres": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "total",
              "libres"
            ]
          }
        },
        "required": [
          "inicio",
          "fin",
          "lugar",
          "plazas"
        ]
      }
    }
  },
  "required": [
    "nombre",
    "orden",
    "linea",
    "resumen"
  ]
}
