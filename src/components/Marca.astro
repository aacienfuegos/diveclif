---
interface Props {
  readonly href?: string;
}
const { href = '/' } = Astro.props;
---
<a class="brand" href={href} aria-label="Dive Clif, inicio">
  <span class="brand-mark">
    <svg width="30" height="20" viewBox="0 0 200 120" fill="#8fd8ea" aria-hidden="true">
      <path d="M100 118 C97 92 96 74 98 58 C82 40 46 30 4 34 C30 14 70 6 100 30 C130 6 170 14 196 34 C154 30 118 40 102 58 C104 74 103 92 100 118Z" />
    </svg>
  </span>
  <span class="brand-name">DIVE CLIF</span>
</a>
